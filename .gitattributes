# Keep shell scripts and other LF-sensitive text as LF on every platform, so a
# Windows checkout (core.autocrlf=true) can't rewrite them to CRLF and break the
# `#!/usr/bin/env bash` shebang or the Docker entrypoints.
*.sh        text eol=lf
*.bash      text eol=lf
*.zeek      text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Makefile    text eol=lf
.env.example text eol=lf

# Windows helper stays CRLF.
*.ps1       text eol=crlf

# Don't let GitHub language stats count vendored/generated assets.
docs/**     linguist-documentation
