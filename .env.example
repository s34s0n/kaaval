# Kaaval — environment. Copy to .env and edit:  cp .env.example .env
# docker compose reads this file automatically.

# ============================================================================
# LLM PROVIDER  (default: OpenRouter — no local GPU/Ollama needed)
# ============================================================================
# provider: openrouter | anthropic | local
KAAVAL_LLM_PROVIDER=openrouter

# OpenRouter API key — REQUIRED for the default provider. Create your own key at
# https://openrouter.ai/keys . OpenRouter is a PAID service: each agent run costs money
# (a few cents with standard models; models tagged ":free" cost nothing). Without a key
# the stack still runs and incidents still form & gate; only the agent narratives degrade.
# To avoid any cloud cost, set KAAVAL_LLM_PROVIDER=local above and run a local model.
OPENROUTER_API_KEY=

# Model slug for the active provider (any OpenRouter model id; leave blank for the
# built-in default meta-llama/llama-3.3-70b-instruct:free). Pick from
# https://openrouter.ai/models  — ":free" models cost nothing.
KAAVAL_LLM_MODEL=

# Optional: point the OpenAI-compatible path at a different gateway URL.
# KAAVAL_OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions

# Anthropic (only if KAAVAL_LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=

# ----------------------------------------------------------------------------
# Fully offline on a local model instead of the cloud:
#   1) set KAAVAL_LLM_PROVIDER=local
#   2a) Mac: run Ollama natively (Metal GPU) — the default OLLAMA_HOST already
#       points at the host; then:  ollama pull qwen3:30b-a3b
#   2b) Linux/other: start the bundled container with:  --profile local
#       and set OLLAMA_HOST=http://ollama:11434 below.
# ----------------------------------------------------------------------------
# OLLAMA_HOST=http://host.docker.internal:11434
# KAAVAL_MODEL=qwen3:30b-a3b

# ============================================================================
# DEMO USERS & SECURITY  (lab only)
# ============================================================================
# The compose file seeds three demo bearer tokens so the human-approval gate and
# separation of duties work out of the box (KAAVAL_SEED_DEMO_USERS=1 is set there):
#     kaaval-admin     (admin)     kaaval-approver  (approver)     kaaval-operator  (operator)
# Log in at the UI with one of these, or use a magic link, e.g.
#     http://localhost:8080/?token=kaaval-operator
# To run with your OWN tokens instead, set KAAVAL_AUTH_TOKENS to a JSON map and the
# demo seed is suppressed:
# KAAVAL_AUTH_TOKENS={"your-secret-token":{"name":"Alice","role":"admin"}}

# ============================================================================
# PLANT PROFILE
# ============================================================================
# Which simulated plant to run: pump | reactor
KAAVAL_PROCESS=pump
