docs/brochure/
docs/*.pptx

# macOS
.DS_Store

# Office temp/lock files
~$*

# Local Claude Code runtime artifacts
.claude/scheduled_tasks.lock

# Runtime stores (regenerated from in-code seeds)
backend/rules.json
backend/assets.json
sim/active_process
backend/llm.json
backend/inventory.json
backend/auth.json

# F6 SIEM runtime config (admin-set, not committed)
backend/siem.json
